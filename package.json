{
  "name": "rca-calculator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/write-release.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check": "npm test && npm run build && npm run check:bundle && npm run check:release && npm run test:ops && npm run test:e2e",
    "start": "node scripts/serve.mjs",
    "check:release": "node scripts/verify-release.mjs",
    "test:ops": "node --test tests/ops.test.mjs",
    "audit": "npm audit --audit-level=high",
    "validate:scenario": "node scripts/validate-scenario.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.51.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.9.0"
}
