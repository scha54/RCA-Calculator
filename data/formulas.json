  "closingStocks": "participatingCustomers*itemsDisposedPerPersonPerYear*deltaCollectionRate*yield*avgWeightKg*(1-reboundFactor)/1000*(1-MIN(1,itemsPerPerson*unwornShare*shareOfUnwornBroughtIntoUse*substitutionRate/MAX(0.000001,itemsDisposedPerPersonPerYear)))",
